{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appkit-manifest-v1",
  "title": "Enterprise App Kit Manifest",
  "type": "object",
  "required": [
    "schema",
    "kit",
    "provider",
    "supported_sdd_methods",
    "supported_agents",
    "defaults",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "appkit-manifest-v1"
    },
    "kit": {
      "type": "object",
      "required": [
        "name",
        "version",
        "appkit_schema",
        "air_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "appkit_schema": {
          "type": "string",
          "minLength": 1
        },
        "air_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "process_studio",
        "manual",
        "mixed"
      ]
    },
    "supported_sdd_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "speckit",
          "openspec"
        ]
      }
    },
    "supported_agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "codex",
          "ibm-bob",
          "kiro"
        ]
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "agent",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "ibm-bob",
            "kiro"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "speckit",
            "openspec"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "signing",
        "sbom"
      ],
      "additionalProperties": false,
      "properties": {
        "signing": {
          "type": "string",
          "minLength": 1
        },
        "sbom": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
